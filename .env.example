# Copy to ~/.config/kapso/kapso.env (chmod 600). server.mjs reads it on start.
# Never commit real values.

# --- Kapso (WhatsApp) ---
KAPSO_API_KEY=                 # Kapso → project → API keys
KAPSO_WEBHOOK_SECRET=          # any long random string: openssl rand -hex 32 (same value on the Kapso webhook)
KAPSO_PHONE_NUMBER_ID=         # the bot number's phone_number_id in Kapso
KAPSO_WEBHOOK_ID=              # only for tunnel.sh (Mac + ngrok setup)

# --- You ---
OWNER_PHONE=56912345678        # your personal WhatsApp, digits only. Every other sender is ignored
OWNER_NAME=                    # used in the morning digest ("Buenos días <name>")
VAULT_PATH=/home/assistant/vault   # the git repo Claude works in (your notes vault)

# --- Behaviour ---
PERMISSIONS=full               # full = bypassPermissions minus FORBIDDEN_TOOLS (dedicated server). allowlist = laptop
GIT_SYNC=1                     # pull before / push after every message
MIRROR_REPOS=                  # extra repos to sync before every message, comma-separated absolute paths
TZ_NAME=America/Santiago
# Morning: the day's first block reminder (+ a greeting at GREETING_TIME on GREETING_DAYS if none) wakes the chat;
# your first message of the day gets the digest (WHOOP sleep + agenda). Other reminders wait until then.
# GREETING_TIME=06:00
# GREETING_DAYS=1,2,3,4,5        # ISO weekdays
# DIGEST_LATEST=10:00            # send the digest anyway if you haven't written
# DIGEST_TIME=05:45              # legacy: fixed-time digest instead of all of the above
REMIND_MINUTES=5               # heads-up before each calendar event
REMINDER_TEMPLATE=agenda_aviso # approved Meta template (one body variable) used outside the 24h window
REMINDER_TEMPLATE_LANG=es
# CLAUDE_MODEL=opus[1m]
# SYSTEM_PROMPT_FILE=/path/to/system-prompt.md
# REMINDERS=0                  # turn off calendar reminders
# AGENDA_CALENDARS=me@gmail.com,me@work.com   # calendars for the digest/reminders (default: all)
# DRY_RUN=1                    # log replies instead of sending (local testing)

# --- Optional: tokens your prompt tells Claude to use (examples) ---
# GITHUB_<ORG>_TOKEN=           # fine-grained PAT, used as GH_TOKEN=$GITHUB_<ORG>_TOKEN gh ...
# MERCURY_API_TOKEN=            # Mercury read-only
# JARVIS_TOKEN=          # key for the /jarvis web HUD
# JARVIS_COMPANIES=[{"name":"Acme","arr":120000}]   # hand-entered ARR (USD) for companies without a live source
# REVENUECAT_API_KEY= / REVENUECAT_PROJECT_ID=   # live revenue + MRR in the HUD
# WHOOP_CLIENT_ID= / WHOOP_CLIENT_SECRET=          # developer.whoop.com → your app
# WHOOP_REDIRECT_URI=https://<host>/whoop/callback  # same value registered on the WHOOP app; then open /whoop/login once
